{
  "name": "mawy-react",
  "version": "1.3.0",
  "description": "A Markdown editor that also does the reading — write in WYSIWYG or in the source, switch freely, and show the finished document through a read-only viewer.",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "homepage": "https://mawy.cdget.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/mawy",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jooy2/mawy/issues"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.prod.json && node scripts/build-styles.mjs",
    "lint": "eslint . --report-unused-disable-directives",
    "parity": "tsx scripts/parity.mjs",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "prepare": "npm run build",
    "size": "node scripts/size.mjs",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.prod.json --noEmit && tsc --project test/tsconfig.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "module": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "module": "./dist/highlight.js",
      "default": "./dist/highlight.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "module": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "module": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ],
      "highlight": [
        "dist/highlight.d.ts"
      ],
      "markdown": [
        "dist/markdown.d.ts"
      ],
      "server": [
        "dist/server.d.ts"
      ]
    }
  },
  "keywords": [
    "mawy",
    "mawy-react",
    "markdown",
    "markdown-editor",
    "markdown-viewer",
    "markdown-parser",
    "wysiwyg",
    "wysiwyg-editor",
    "rich-text",
    "rich-text-editor",
    "text-editor",
    "editor",
    "viewer",
    "preview",
    "react",
    "reactjs",
    "react-component",
    "react-markdown",
    "typescript",
    "tsx",
    "esm",
    "accessible",
    "accessibility",
    "a11y",
    "dark-mode"
  ],
  "dependencies": {
    "lucide-react": "^1.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "axe-core": "^4.13.0",
    "commonmark-spec": "0.31.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
