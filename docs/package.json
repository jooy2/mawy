{
  "name": "mawy-docs",
  "version": "0.0.1",
  "description": "The documentation site for Mawy, shared by every language the library ships for.",
  "private": true,
  "type": "module",
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "scripts": {
    "changelog": "node scripts/copy-changelog.mjs",
    "flutter": "node scripts/build-flutter.mjs",
    "dev": "npm run changelog && vitepress dev",
    "build": "npm run changelog && vitepress build",
    "serve": "npm run build && vitepress serve",
    "lint": "eslint . --report-unused-disable-directives",
    "screenshot": "node scripts/screenshot-readme.mjs",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "typecheck": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.44.0",
    "markdown-it-container": "^4.0.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vitepress-i18n": "^1.4.0",
    "vitepress-sidebar": "^1.40.0"
  }
}
